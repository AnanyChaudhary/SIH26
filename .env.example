# KisanSetu Production Environment Configuration Template
# Direct Farm-to-Table Marketplace for India

# 1. DATABASE & PERSISTENCE
DATABASE_URL="postgresql://kisansetu_user:CHANGE_ME@localhost:5432/kisansetu_db?schema=public"
REDIS_URL="redis://localhost:6379"

# 2. AUTHENTICATION & JWT
JWT_SECRET="generate_a_secure_64_byte_random_string_for_production_jwt"
JWT_EXPIRES_IN="7d"
SESSION_COOKIE_NAME="kisansetu_session"

# 3. PAYMENT GATEWAYS
# Razorpay (India primary payment partner)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook"

# Stripe (Global export / Institutional wholesale)
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# 4. STORAGE (AWS S3 / Cloudflare R2)
AWS_REGION="ap-south-1" # Mumbai region
AWS_ACCESS_KEY_ID="placeholder_access_key"
AWS_SECRET_ACCESS_KEY="placeholder_secret_key"
AWS_S3_BUCKET="kisansetu-harvest-assets"
CDN_DOMAIN="https://assets.kisansetu.in"

# 5. AGRICULTURAL DATA FEEDS
# Government of India Agmarknet / APMC Mandi Data Gateway (data.gov.in)
AGMARKNET_API_KEY=""

# Weather Telemetry Service (Open-Meteo or IMD API)
WEATHER_API_KEY=""

# 6. FARMER VOICE ASSISTANT & AI
AI_PROVIDER="openai" # openai, bhashini, anthropic
AI_API_KEY="placeholder_ai_key"
BHASHINI_API_KEY="placeholder_bhashini_regional_key"

# 7. NOTIFICATIONS & SMS
# Fast2SMS / Twilio for Rural Farmer SMS notifications
SMS_API_KEY="placeholder_sms_key"
FIREBASE_SERVER_KEY="placeholder_fcm_key"

# 8. OBSERVABILITY & MONITORING
SENTRY_DSN=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# 9. RUNTIME ENVIRONMENT
NODE_ENV="development"
PORT=3000
